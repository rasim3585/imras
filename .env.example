# pickplay.ai — environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored; NEVER commit real keys.
#
# Find these in your Supabase dashboard:
#   Project Settings -> API
#   - Project URL      -> VITE_SUPABASE_URL
#   - anon / public key -> VITE_SUPABASE_ANON_KEY  (safe for the browser; RLS protects data)

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- BSD real-fixtures provider (Faz 2) -------------------------------------
# SERVER / CRON ONLY. No VITE_ prefix so it never reaches the browser bundle.
# Free football tier, token auth. Key lives only in `.env`.
BSD_BASE_URL=https://sports.bzzoiro.com
BSD_API_KEY=your-bsd-token
# The cron process also needs a service-role Supabase client (write access):
# SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
