# pickplay.ai — environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored; NEVER commit real keys.
#
# Find these in your Supabase dashboard:
#   Project Settings -> API
#   - Project URL      -> VITE_SUPABASE_URL
#   - anon / public key -> VITE_SUPABASE_ANON_KEY  (safe for the browser; RLS protects data)

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
